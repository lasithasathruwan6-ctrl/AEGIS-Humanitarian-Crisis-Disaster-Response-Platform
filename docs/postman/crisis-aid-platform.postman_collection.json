{
  "info": {
    "_postman_id": "c1a2d3e4-f5a6-7b8c-9d0e-1f2a3b4c5d6e",
    "name": "Crisis Aid Platform",
    "description": "Complete API test suite for the Crisis Aid Platform.\n\nFolders:\n- **Auth** – register, login, OTP verify/resend, refresh, logout\n- **Request Lifecycle** – create, view own, assign, update status\n- **Decisions & Audit** – AI recommendation approve, audit log verification\n- **Conflict (409)** – allocation exceeds shelter capacity\n\nUse the `crisis-aid-platform` environment. Run with Newman:\n  newman run crisis-aid-platform.postman_collection.json \\\n    -e crisis-aid-platform.postman_environment.json\n\nSee docs/testing/newman-guide.md for a full run guide.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "{{baseUrl}}",      "type": "string" },
    { "key": "accessToken",  "value": "",                  "type": "string" },
    { "key": "refreshToken", "value": "",                  "type": "string" },
    { "key": "requestId",    "value": "",                  "type": "string" },
    { "key": "recommendationId", "value": "",              "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication flows: register, login, OTP verify/resend, token refresh, logout.",
      "item": [
        {
          "name": "Register citizen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Citizen\",\n  \"email\": \"citizen@test.invalid\",\n  \"password\": \"Test@12345!\",\n  \"nic\": \"199012345678\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has userId', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('userId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@test.invalid\",\n  \"password\": \"Test@12345!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('OTP required flag is true', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.otpRequired).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "OTP verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","otp","verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@test.invalid\",\n  \"code\": \"{{otpCode}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Access token is returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.expect(body).to.have.property('refreshToken');",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "OTP resend",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/otp/resend", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","otp","resend"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@test.invalid\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 429 (cooldown)', () => {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('New access token returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unauthenticated refresh is rejected",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"invalid-token-value\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid refresh token is rejected with 401', () => {",
                  "  pm.expect([401, 400]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Request Lifecycle",
      "description": "Create a citizen request, view it, assign it (staff), and update its status.",
      "item": [
        {
          "name": "Create request (citizen)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/requests", "host": ["{{baseUrl}}"], "path": ["api","v1","requests"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Medical\",\n  \"description\": \"Need insulin — diabetes medication ran out\",\n  \"location\": { \"latitude\": 6.9271, \"longitude\": 79.8612 }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Request id is returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.collectionVariables.set('requestId', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "View own request (citizen)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","requests","{{requestId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Id matches', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('requestId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List all requests (staff)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/requests", "host": ["{{baseUrl}}"], "path": ["api","v1","requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Assign request (staff)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/requests/{{requestId}}/assign", "host": ["{{baseUrl}}"], "path": ["api","v1","requests","{{requestId}}","assign"] },
            "body": { "mode": "raw", "raw": "{\n  \"volunteerId\": \"{{volunteerId}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update status to InProgress (staff)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api","v1","requests","{{requestId}}","status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"InProgress\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Citizen cannot list all requests (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/requests", "host": ["{{baseUrl}}"], "path": ["api","v1","requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Citizen cannot list all requests — 403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Decisions & Audit",
      "description": "Human-in-the-loop AI recommendation approval, rejection, and audit log verification.",
      "item": [
        {
          "name": "Approve AI recommendation (coordinator)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{coordinatorAccessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/ai/recommendations/{{recommendationId}}/approve", "host": ["{{baseUrl}}"], "path": ["api","v1","ai","recommendations","{{recommendationId}}","approve"] },
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Approved after manual review\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Decision status is Approved', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('Approved');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reject AI recommendation (coordinator)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{coordinatorAccessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/ai/recommendations/{{recommendationId}}/reject", "host": ["{{baseUrl}}"], "path": ["api","v1","ai","recommendations","{{recommendationId}}","reject"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Capacity already filled by prior allocation\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Citizen cannot approve recommendation (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/ai/recommendations/{{recommendationId}}/approve", "host": ["{{baseUrl}}"], "path": ["api","v1","ai","recommendations","{{recommendationId}}","approve"] },
            "body": { "mode": "raw", "raw": "{}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Citizen gets 403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get audit log (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/audit-log", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","audit-log"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Audit log is an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Entries have required fields', () => {",
                  "  const entries = pm.response.json();",
                  "  if (entries.length > 0) {",
                  "    pm.expect(entries[0]).to.have.property('action');",
                  "    pm.expect(entries[0]).to.have.property('performedBy');",
                  "    pm.expect(entries[0]).to.have.property('timestamp');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Non-admin cannot read audit log (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/audit-log", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","audit-log"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Citizen gets 403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
