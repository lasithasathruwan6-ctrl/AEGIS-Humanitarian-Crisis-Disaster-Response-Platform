{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigin": "http://localhost:5173"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "ExternalClients": {
    "OpenMeteo": {
      "TimeoutSeconds": 5,
      "MaxRetries": 3,
      "BaseDelayMs": 200,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakSeconds": 30
    },
    "Routing": {
      "TimeoutSeconds": 4,
      "MaxRetries": 2,
      "BaseDelayMs": 150,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakSeconds": 30
    },
    "AiService": {
      "TimeoutSeconds": 10,
      "MaxRetries": 2,
      "BaseDelayMs": 250,
      "CircuitBreakerFailureThreshold": 4,
      "CircuitBreakerBreakSeconds": 45
    },
    "EmailFeed": {
      "TimeoutSeconds": 8,
      "MaxRetries": 3,
      "BaseDelayMs": 300,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakSeconds": 60
    }
  }
}
