# Copy to .env (git-ignored) for local use, or set the same names as environment variables.
# In .NET, "__" in a variable name maps to ":" in configuration (Auth__Tokens__SigningKey = Auth:Tokens:SigningKey).
# For day-to-day development prefer user-secrets:
#   dotnet user-secrets init --project backend/CrisisPlatform.Api
#   dotnet user-secrets set "Auth:Tokens:SigningKey" "<value>" --project backend/CrisisPlatform.Api
# NEVER put real values in this file. See docs/security/secrets.md.

# JWT signing secret, at least 32 bytes. Generate: openssl rand -base64 48
Auth__Tokens__SigningKey=

# Keys for NIC protection, each base64 of 32 random bytes. Generate: openssl rand -base64 32
# Use different values for the encryption key, the hash key and the OTP key.
Security__NicEncryptionKey=
Security__NicHashKey=
Security__OtpHashKey=

# SQL Server connection string (use a least-privilege login, never sa)
ConnectionStrings__Default=

# Outgoing email for OTP and invitations
Smtp__Host=
Smtp__Username=
Smtp__Password=

# The single browser origin allowed by CORS, for example https://app.example.org
Cors__AllowedOrigin=
